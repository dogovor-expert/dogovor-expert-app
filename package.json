{
  "name": "dogovor-templates",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:acts": "node scripts/audit-actsource.mjs",
    "check:blast": "node scripts/check-blast-radius.mjs",
    "check:related": "vitest related --run",
    "check:smoke": "node scripts/smoke.mjs",
    "check:smoke:prod": "node scripts/smoke.mjs --prod",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:all": "npm run typecheck && npm run lint && npm run check:blast -- --staged && npm run test:unit",
    "knip": "knip",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "biome:format": "biome format --write .",
    "generate:blank-previews": "tsx scripts/generate-blank-previews.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude=**/__integration__/**",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:prod": "playwright test --config=playwright.prod.config.ts",
    "analyze": "ANALYZE=true next build",
    "lighthouse": "lhci autorun --config=lighthouserc.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "verify": "npm run typecheck && npm run lint && npm run test:unit",
    "prepare": "husky",
    "psi": "node scripts/psi.mjs",
    "audit:squirrel": "squirrel audit https://dogovor.expert --format llm",
    "audit:full": "node scripts/run-full-audit.mjs",
    "audit:quick": "node scripts/run-full-audit.mjs --quick",
    "audit:site": "node scripts/run-full-audit.mjs --site-only",
    "deploy:tsl": "node scripts/deploy-tsl.mjs",
    "migrate:tsl": "node scripts/apply-migration.mjs 20260907_tsl_certificates.sql",
    "tsl:status": "curl -sS -H \"Authorization: Bearer $CRON_SECRET\" \"$VERCEL_URL/api/cron/tsl-refresh?action=status\" || echo \"Set VERCEL_URL and CRON_SECRET\"",
    "tsl:refresh": "curl -sS -X POST -H \"Authorization: Bearer $CRON_SECRET\" \"$VERCEL_URL/api/cron/tsl-refresh\" || echo \"Set VERCEL_URL and CRON_SECRET\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@huggingface/transformers": "^4.2.0",
    "@li0ard/gost": "^0.2.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@peculiar/asn1-cms": "^2.9.4",
    "@peculiar/asn1-x509": "^2.9.4",
    "@peculiar/webcrypto": "^1.7.1",
    "@sentry/nextjs": "^10.73.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "asn1js": "^3.0.10",
    "docx": "^9.7.1",
    "dompurify": "^3.4.14",
    "fast-xml-parser": "^5.11.1",
    "file-saver": "^2.0.5",
    "linkedom": "^0.18.13",
    "lucide-react": "^0.417.0",
    "lz-string": "^1.5.0",
    "mammoth": "^1.12.1",
    "mrz": "^5.0.2",
    "mustache": "^4.2.0",
    "next": "^15.5.23",
    "node-gost-crypto": "^1.0.2",
    "onnxruntime-web": "^1.29.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pkijs": "^3.4.0",
    "ppu-ocv": "^4.0.0",
    "ppu-paddle-ocr": "^6.4.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.8",
    "react-dom": "^19.0.8",
    "react-hook-form": "^7.87.0",
    "react-to-print": "^3.3.0",
    "scanic": "^1.6.0",
    "tesseract.js": "^7.0.0",
    "xml-crypto": "^6.1.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@lhci/cli": "^0.15.1",
    "@napi-rs/canvas": "^0.1.65",
    "@next/bundle-analyzer": "^15.5.25",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/nextjs": "^10.5.10",
    "@storybook/react": "^10.5.10",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/file-saver": "^2.0.7",
    "@types/mustache": "^4.2.6",
    "@types/node": "^20.14.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.23",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.26",
    "squirrelscan": "^0.0.90",
    "storybook": "^10.5.10",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26",
      "sharp": "0.35.3"
    },
    "@huggingface/transformers": {
      "sharp": "0.35.4"
    },
    "@xmldom/xmldom": "0.8.15",
    "adm-zip": "0.6.0"
  }
}
