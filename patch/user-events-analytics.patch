--- /dev/null
+++ b/src/components/analytics/UserEventsPageView.tsx
@@ -0,0 +1,37 @@
+"use client";
+
+/**
+ * Просмотры страниц в собственный журнал (/api/events → user_events).
+ * Гейтится тем же cookie-consent (categories.analytics), что и Метрика —
+ * хотя это first-party аналитика, а не сторонний счётчик, поведенчески
+ * это тот же тип данных, который политика конфиденциальности описывает
+ * как «аналитика», поэтому отказ пользователя должен отключать оба канала
+ * одинаково (не создавать несоответствие между политикой и кодом).
+ */
+import { Suspense, useEffect } from "react";
+import { usePathname, useSearchParams } from "next/navigation";
+import { useCookieConsent } from "@/hooks/useCookieConsent";
+import { trackOwnOnly, goals } from "@/lib/analytics";
+
+export function UserEventsPageView() {
+  return (
+    <Suspense fallback={null}>
+      <UserEventsPageViewInner />
+    </Suspense>
+  );
+}
+
+function UserEventsPageViewInner() {
+  const pathname = usePathname();
+  const searchParams = useSearchParams();
+  const { isReady, categories } = useCookieConsent();
+
+  useEffect(() => {
+    if (!isReady || !categories.analytics) return;
+    trackOwnOnly(goals.pageView);
+    // searchParams намеренно в зависимостях (как в YandexMetrikaPageView) —
+    // чтобы фиксировать и переходы, меняющие только query.
+  }, [pathname, searchParams, isReady, categories.analytics]);
+
+  return null;
+}
