{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,loading,error,global-error,not-found,template,default,opengraph-image,icon,apple-icon,sitemap,robots,manifest}.{ts,tsx}",
    "src/middleware.ts",
    "src/lib/workers/*.{ts,js}",
    "scripts/**/*.{mjs,js,ts}",
    "src/**/*.{test,spec}.{ts,tsx}",
    "src/**/__tests__/**/*.{ts,tsx}",
    "src/**/*.stories.{ts,tsx}",
    ".storybook/**/*.{ts,tsx,js}",
    "next.config.mjs",
    "eslint.config.mjs",
    "postcss.config.mjs",
    "tailwind.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{mjs,js,ts}"],
  "ignore": ["**/*.d.ts"],
  "ignoreBinaries": ["prettier"],
  "ignoreDependencies": ["prettier"]
}
