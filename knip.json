{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{layout,page,loading,error,not-found}.tsx",
    "src/app/api/**/route.ts",
    "src/workers/pdf.worker.ts",
    "scripts/**/*.mjs"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "**/*.stories.tsx",
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/e2e/**",
    "**/.next/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/audit/**",
    "**/audit-shots/**",
    "**/visual-report/**",
    "**/coverage/**",
    "**/docs/**",
    "**/samples/**",
    "**/.opencode/**",
    "**/node_modules/**",
    "src/workers/pdf.worker.ts",
    "src/lib/workers/**",
    "public/workers/**",
    ".lintstagedrc.js",
    "commitlint.config.mjs",
    "scripts/**",
  ],
  "ignoreDependencies": [
    "@types/*",
    "@axe-core/*",
    "@lhci/cli",
    "@napi-rs/canvas",
    "@next/bundle-analyzer",
    "@playwright/test",
    "@storybook/*",
    "@testing-library/*",
    "@types/file-saver",
    "@types/mustache",
    "@types/qrcode",
    "@types/react",
    "@types/react-dom",
    "@vitejs/plugin-react",
    "@vitest/*",
    "autoprefixer",
    "eslint",
    "eslint-config-next",
    "eslint-config-prettier",
    "husky",
    "jsdom",
    "lint-staged",
    "playwright",
    "playwright-core",
    "postcss",
    "tailwindcss",
    "tsx",
    "typescript",
    "vite-tsconfig-paths",
    "vitest",
    "@biomejs/biome",
    "@commitlint/cli",
    "@commitlint/config-conventional",
    "knip"
  ],
  "rules": {
    "files": "warn",
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn",
    "dependencies": "warn",
    "unlisted": "error"
  },
  "ignoreBinaries": ["knip", "biome", "husky", "commitlint", "gitleaks", "semgrep"],
  "ignoreWorkspaces": ["public", ".opencode"],
}
