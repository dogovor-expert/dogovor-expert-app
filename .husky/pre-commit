#!/usr/bin/env sh
# AGENTS.md Quality Gate (Stage 1): pre-commit hooks.
#
# Перед каждым коммитом проверяем:
#   1. tsc --noEmit (5-15s) — TypeScript strict
#   2. ESLint (10-30s) — стиль + баги
#   3. vitest related --staged (3-10s) — только тесты для изменённых файлов
#   4. check-blast-radius (1-2s) — список потребителей
#   5. check-secrets (gitleaks, 1-3s) — секреты в staged-файлах (если gitleaks установлен)
#
# Если что-то падает — коммит отменяется.
# Обходимо через: git commit --no-verify (только для экстренных случаев).

set -e

echo "🔍 AGENTS Quality Gate..."

# 1. TypeScript
echo "  • typecheck..."
npx tsc --noEmit

# 2. Lint
echo "  • lint..."
npm run lint

# 2b. Client-exports gate (причина №1 падений деплоя, ~1s)
echo "  • client-exports..."
node scripts/check-client-exports.mjs

# 3. Blast radius для staged файлов
echo "  • blast radius (staged files)..."
node scripts/check-blast-radius.mjs --staged || true

# 4. Vitest related для staged файлов
STAGED=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -E "^(src/.*\.(ts|tsx))$" | head -5)
if [ -n "$STAGED" ]; then
  echo "  • vitest related..."
  # Запускаем vitest related по первому staged-файлу
  FIRST=$(echo "$STAGED" | head -1)
  npx vitest related "$FIRST" --run --reporter=default || {
    echo "⚠️  vitest related failed for $FIRST. Run 'npm run test:unit' manually."
  }
fi

# 5. Gitleaks — секреты в staged-файлах (если установлен)
if command -v gitleaks >/dev/null 2>&1; then
  echo "  • gitleaks (staged secrets)..."
  node scripts/check-secrets.mjs || {
    echo "❌ SECRETS DETECTED — коммит заблокирован."
    exit 1
  }
else
  echo "  ⚠️  gitleaks не установлен — проверка секретов пропущена"
fi

echo "✅ Pre-commit checks passed."
