{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "tool_output": {
    "max_lines": 100,
    "max_bytes": 4096
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000,
    "preserve_recent_tokens": 8000,
    "tail_turns": 10,
    "keep": { "tokens": 8000 },
    "buffer": 20000
  },
  "experimental": {
    "truncate_all_tool_outputs": true,
    "preemptive_compaction": true,
    "preemptive_compaction_threshold": 0.8
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true,
      "environment": { "BROWSER_TYPE": "chromium" },
      "timeout": 30000
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": false,
      "oauth": true
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "npx tsc*": "allow",
      "npm run test*": "allow",
      "npm test*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "node *": "allow",
      "*": "ask"
    }
  }
}
